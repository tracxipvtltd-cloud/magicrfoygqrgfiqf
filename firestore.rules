rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 1000)) &&
             (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
             (!('gamesPlayed' in data) || (data.gamesPlayed is number && data.gamesPlayed >= 0)) &&
             (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
             (!('bestStreak' in data) || (data.bestStreak is number && data.bestStreak >= 0)) &&
             (!('totalCorrect' in data) || (data.totalCorrect is number && data.totalCorrect >= 0)) &&
             (!('totalWrong' in data) || (data.totalWrong is number && data.totalWrong >= 0)) &&
             (!('avgReactionTime' in data) || (data.avgReactionTime is number && data.avgReactionTime >= 0));
    }

    function isValidGameScore(data) {
      return data.scoreId is string && data.scoreId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.score is number && data.score >= 0 &&
             data.matrixSize is number && data.matrixSize >= 3 && data.matrixSize <= 8 &&
             (!('targetSum' in data) || (data.targetSum is number && data.targetSum >= 1 && data.targetSum <= 1000)) &&
             data.mode is string && data.mode.size() <= 30 &&
             (!('accuracy' in data) || (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100)) &&
             (!('timeSeconds' in data) || (data.timeSeconds is number && data.timeSeconds >= 0)) &&
             (!('maxStreak' in data) || (data.maxStreak is number && data.maxStreak >= 0));
    }

    function isValidDailyRecord(data) {
      return data.recordId is string && data.recordId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.challengeDate is string && data.challengeDate.size() <= 20 &&
             data.score is number && data.score >= 0;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Leaderboard / Game scores
    match /scores/{scoreId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) && isValidGameScore(incoming());
      allow update, delete: if false;
    }

    // Daily Challenge Records
    match /dailyRecords/{recordId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(recordId) && isValidDailyRecord(incoming());
      allow update, delete: if false;
    }

    // Test connection doc for initial boot validation
    match /test/{docId} {
      allow read: if true;
    }
  }
}
